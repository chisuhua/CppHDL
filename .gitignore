# 忽略构建目录
build/
cmake-build-*/
*.build/
Debug/
Release/

# 忽略VSCode配置
#.vscode/
.idea/
.continue/

# 忽略编译生成的文件
*.o
*.a
*.so
*.dylib
*.exe
*.out
*.bin
*.dll

# 忽略CMake生成的文件
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
compile_commands.json

# 忽略临时文件
*.swp
*.swo
*~
.DS_Store
.worktrees/
.aider*
.cache/
Testing/

# 忽略测试生成的输出
tests/output/
# Added by code-review-graph
.code-review-graph/

# 忽略代码生成 / 仿真调试产物（防止 verilog_gen 测试运行后产物被误提交）
*.dot
*.v
*.dag
verilog_gen.v
test_reg_timing_feedback.dot

# 忽略 AI 工具环境配置（Claude / Gemini / Kiro / Qoder / Cursor / Windsurf / opencode / MCP）
.claude/
.gemini/
.kiro/
.qoder/
.cursorrules
.windsurfrules
CLAUDE.md
GEMINI.md
QODER.md
.opencode.json
.mcp.json
.omo/
.understand-anything/
.github/code-review-graph.instruction.md

# 忽略 perf 性能测试自动生成产物（由 perf_main + run_perf_comparison.sh / benchmark_tracker.sh 写入根目录）
# 规范的副本保留在 build/perf_report.{csv,json,md} 中（已通过 build/ 忽略）。
perf_results.csv
perf_results.json
perf_results.md
perf_history.csv

# 忽略 perf F2 修复机制 sentinel 文件（test_perf_subprocess_isolation 在 RAII 中备份 perf_results.json
# 为 .__saved/.__saved2，以便从上一次 SIGKILL/ctest TIMEOUT 中恢复；这些是运行时临时残留）
perf_results.json.__saved*

# 忽略 CMake in-source build 产物
# 任何在源码树就地 cmake . + make 的运行都会生成这些。
# 规范姿势: cmake -B build && cmake --build build
/Makefile
/*/Makefile
/*/*/Makefile
/*/*/*/Makefile
/CTestTestfile.cmake
/*/CTestTestfile.cmake
/*/*/CTestTestfile.cmake

# 忽略 CMake ExternalProject_Add 产物 (verilator-build/verilator-install/verilator-prefix)
# 这些是 third_party/verilator 子模块的隔离构建输出，不应入库
verilator-build/
verilator-install/
verilator-prefix/

# 忽略 verilator_backend 运行时输出（test_verilator_* 单元测试 + e2e harness 写到工作区）
# 这些 .v 文件是 Verilator 编译中间产物，每次跑测试都重新生成
/tests/*.v
/tests/**/*.v

# rdd-workflow runtime state (per rdd-workflow reference .gitignore):
# .rddf/state/ and .rddf/wt/ are ephemeral per-session artifacts
# (arch/builder handoffs, worktree, role.json); .rddf/plans/ IS tracked.
# 不在 .rddf/state/ 入库避免 PR diff 噪声 + 角色/会话身份泄露。
/.rddf/state/
/.rddf/wt/

# 忽略其它构建目录变体
build-test/
build*/
